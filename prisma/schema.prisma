generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id             String    @id @default(cuid())
  userId         String
  nickname       String
  institution    String
  accountType    String
  // checking | savings | brokerage | 401k | ira | roth_ira | real_estate
  // nre | nro | fcnr | fd | mutual_fund | property | gold | other
  country        String
  // US | IN
  balanceUsd     Float
  balanceInr     Float
  currency       String    @default("USD")
  isManual       Boolean   @default(true)
  source         String    @default("manual")
  // manual | plaid | setu | pdf_upload
  kind           String    @default("asset")
  // asset | liability — absent on the client Holding means asset
  isPfic         Boolean   @default(false)
  // For a liability: the id of the Account it's secured against (e.g. a mortgage
  // -> the home). App-managed reference (not a DB FK) so bulk-restore ordering is
  // free and the DELETE handler unlinks explicitly. Nulled when the asset is deleted.
  securedAgainstId String?
  // Whose name the asset/debt is held in: self | joint | family. Foundational
  // data for the Legacy ("who owns what") view.
  ownership      String    @default("self")
  // Co-holders for joint, or the title-holder(s) for family: [{ name, relation }].
  coOwners       Json?
  // Instrument-specific attributes (interestRate, maturityDate, tdsRate, ...).
  // Mirrors the HoldingDetails shape; only fields relevant to the type are set.
  details        Json?
  plaidAccountId String?   @unique
  // The PlaidItem.itemId this account syncs through — lets a row show "Reconnect"
  // when its item needs re-login. Set on link and on every sync.
  plaidItemId    String?
  setuConsentId  String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  snapshots BalanceSnapshot[]

  @@index([userId])
}

// Daily balance history (net-worth trend; FBAR peak balance later). At most one
// row per account per UTC day: `day` is the UTC date, and a later write that day
// updates the row in place (see src/lib/snapshots.ts). Rows written before `day`
// existed have it null.
model BalanceSnapshot {
  id         String    @id @default(cuid())
  accountId  String
  balanceUsd Float
  balanceInr Float
  day        DateTime? @db.Date
  recordedAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, day])
  @@index([accountId, recordedAt])
}

// A savings goal. Mirrors the client `Goal` shape (src/lib/goals.ts).
model Goal {
  id                String   @id @default(cuid())
  userId            String
  name              String
  category          String
  // retirement | education | property | travel | emergency | other | debt
  kind              String?
  // cost | investment — null means the category default
  targetUsd         Float
  currentUsd        Float    @default(0)
  targetYear        Int
  // Account ids earmarked to this goal. App-managed (not FKs): an account funds at
  // most one goal, and the account DELETE handler removes its id from here.
  linkedAccountIds  String[] @default([])
  // What the user plans to put in each month (drives the on-track status chip).
  plannedMonthlyUsd Float?
  // Debt payoff only: the liability being paid off (app-managed; nulled when the
  // loan is deleted) and its starting balance in the loan's own currency.
  linkedLiabilityId String?
  originalAmount    Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// One budget per user: monthly income + categories ({ id, label, amount, color }[]).
model Budget {
  userId     String   @id
  incomeUsd  Float    @default(0)
  categories Json
  updatedAt  DateTime @updatedAt
}

model FxRate {
  id        String   @id @default(cuid())
  pair      String   @unique
  rate      Float
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  messages  String
  // JSON string — array of { role, content, timestamp, model }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Running compliance numbers — updated on every account sync
model ComplianceData {
  id                  String   @id @default(cuid())
  userId              String   @unique
  indiaPeakBalanceUsd Float    @default(0)
  indiaDaysCurrentYear Int     @default(0)
  lrsUsedUsd          Float    @default(0)
  updatedAt           DateTime @updatedAt
}

// Plaid linked institutions — access tokens encrypted before storing
model PlaidItem {
  id                   String   @id @default(cuid())
  userId               String
  itemId               String   @unique
  accessTokenEncrypted String
  institutionId        String
  institutionName      String
  status               String   @default("active")
  // active | requires_reauth | disconnected
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}
